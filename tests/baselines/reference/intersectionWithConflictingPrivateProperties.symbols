//// [tests/cases/conformance/types/intersection/intersectionWithConflictingPrivateProperties.ts] ////

=== intersectionWithConflictingPrivateProperties.ts ===
// An intersection of types that declare same-named private properties originating from
// different classes is reduced to `never`. Indexed accesses for such a property must
// report an error instead of silently resolving to `never` (see #62294).

class A {
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))

    private a = { foo: 1 };
>a : Symbol(A.a, Decl(intersectionWithConflictingPrivateProperties.ts, 4, 9))
>foo : Symbol(foo, Decl(intersectionWithConflictingPrivateProperties.ts, 5, 17))
}

class B {
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))

    private a = { bar: "bar" };
>a : Symbol(B.a, Decl(intersectionWithConflictingPrivateProperties.ts, 8, 9))
>bar : Symbol(bar, Decl(intersectionWithConflictingPrivateProperties.ts, 9, 17))
}

// Direct non-generic intersection
type T1 = (A & B)["a"]; // Error
>T1 : Symbol(T1, Decl(intersectionWithConflictingPrivateProperties.ts, 10, 1))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))

type T2 = (A & B)["missing"]; // Ok, indexing `never` is permissive
>T2 : Symbol(T2, Decl(intersectionWithConflictingPrivateProperties.ts, 13, 23))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))

// Generic intersection
type T3<T extends A, U extends B> = (T & U)["a"]; // Error
>T3 : Symbol(T3, Decl(intersectionWithConflictingPrivateProperties.ts, 14, 29))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 17, 8))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>U : Symbol(U, Decl(intersectionWithConflictingPrivateProperties.ts, 17, 20))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 17, 8))
>U : Symbol(U, Decl(intersectionWithConflictingPrivateProperties.ts, 17, 20))

// Type parameter constrained by an intersection
type T4<T extends A & B> = T["a"]; // Error
>T4 : Symbol(T4, Decl(intersectionWithConflictingPrivateProperties.ts, 17, 49))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 20, 8))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 20, 8))

type T5<T extends A & B> = T["a"]["b"]["c"]["d"]; // Error
>T5 : Symbol(T5, Decl(intersectionWithConflictingPrivateProperties.ts, 20, 34))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 21, 8))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 21, 8))

// Accessed through an alias
type AB = A & B;
>AB : Symbol(AB, Decl(intersectionWithConflictingPrivateProperties.ts, 21, 49))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))

type T6 = AB["a"]; // Error
>T6 : Symbol(T6, Decl(intersectionWithConflictingPrivateProperties.ts, 24, 16))
>AB : Symbol(AB, Decl(intersectionWithConflictingPrivateProperties.ts, 21, 49))

// Nested in a conditional type
type T7<T extends A, U extends B> = T extends never ? never : (T & U)["a"]; // Error
>T7 : Symbol(T7, Decl(intersectionWithConflictingPrivateProperties.ts, 25, 18))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 28, 8))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>U : Symbol(U, Decl(intersectionWithConflictingPrivateProperties.ts, 28, 20))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 28, 8))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 28, 8))
>U : Symbol(U, Decl(intersectionWithConflictingPrivateProperties.ts, 28, 20))

// Element access in expression position
function f1<T extends A, U extends B>(x: T & U) {
>f1 : Symbol(f1, Decl(intersectionWithConflictingPrivateProperties.ts, 28, 75))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 31, 12))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>U : Symbol(U, Decl(intersectionWithConflictingPrivateProperties.ts, 31, 24))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))
