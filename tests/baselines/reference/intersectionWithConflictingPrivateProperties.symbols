>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 31, 12))
>U : Symbol(U, Decl(intersectionWithConflictingPrivateProperties.ts, 31, 24))

    const v1 = x["a"]; // Error
>v1 : Symbol(v1, Decl(intersectionWithConflictingPrivateProperties.ts, 32, 9))
>x : Symbol(x, Decl(intersectionWithConflictingPrivateProperties.ts, 31, 38))

    x["a"] = { foo: 1 }; // Error
>x : Symbol(x, Decl(intersectionWithConflictingPrivateProperties.ts, 31, 38))
>foo : Symbol(foo, Decl(intersectionWithConflictingPrivateProperties.ts, 33, 14))

    const { a } = x; // Error
>a : Symbol(a, Decl(intersectionWithConflictingPrivateProperties.ts, 34, 11))
>x : Symbol(x, Decl(intersectionWithConflictingPrivateProperties.ts, 31, 38))
}

// Class expressions declare private members too
const CE = class {
>CE : Symbol(CE, Decl(intersectionWithConflictingPrivateProperties.ts, 38, 5))

    private a = 1;
>a : Symbol(CE.a, Decl(intersectionWithConflictingPrivateProperties.ts, 38, 18))

};
type T8 = (InstanceType<typeof CE> & B)["a"]; // Error
>T8 : Symbol(T8, Decl(intersectionWithConflictingPrivateProperties.ts, 40, 2))
>InstanceType : Symbol(InstanceType, Decl(lib.es5.d.ts, --, --))
>CE : Symbol(CE, Decl(intersectionWithConflictingPrivateProperties.ts, 38, 5))
>B : Symbol(B, Decl(intersectionWithConflictingPrivateProperties.ts, 6, 1))

// Single-class private member access on a type parameter still reports TS4105
type T9<T extends A> = T["a"]; // Error
>T9 : Symbol(T9, Decl(intersectionWithConflictingPrivateProperties.ts, 41, 45))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 44, 8))
>A : Symbol(A, Decl(intersectionWithConflictingPrivateProperties.ts, 0, 0))
>T : Symbol(T, Decl(intersectionWithConflictingPrivateProperties.ts, 44, 8))

// Accesses to non-conflicting properties are unaffected
